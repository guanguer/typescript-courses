{
  "name": "chat-stdlib",
  "packageManager": "yarn@3.6.4",
  "main": "dist/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "yarn tsc",
    "lint": "yarn eslint src --ext js,ts",
    "watch-build": "yarn tsc --watch --preserveWatchOutput",
    "watch-test": "yarn jest --watch",
    "watch": "yarn concurrently --names 'TS,JEST' -c 'red,blue' 'yarn watch-build' 'yarn watch-test'",
    "test": "yarn build && yarn jest"
  },
  "volta": {
    "node": "24.21.0",
    "yarn": "3.8.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/eslint": "8.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "typescript": "~5.3.0",
    "typescript-eslint": "^8.72.1"
  }
}
